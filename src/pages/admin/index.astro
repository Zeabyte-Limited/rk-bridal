---
// Studio admin — a phone-first mini app for the owner. Static page; all data via /api/admin/*.
import "../../styles/global.css";
import { SITE } from "../../config";
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="theme-color" content="#6b0f1a" />
  <title>Studio — {SITE.name}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style is:global>
    body { background: #f6f1ea; }
    .a-card { background: #fff; border: 1px solid rgba(30,20,25,.08); border-radius: 18px; box-shadow: 0 8px 24px -18px rgba(107,15,26,.35); }
    .a-in { width: 100%; border: 1px solid rgba(30,20,25,.18); background: #fff; border-radius: 12px; padding: .8rem .9rem; font-size: 16px; outline: none; }
    .a-in:focus { border-color: #6b0f1a; box-shadow: 0 0 0 3px rgba(107,15,26,.12); }
    .a-lbl { display: block; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: #6f5f66; margin: 0 0 .35rem; }
    .a-btn { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; border-radius: 999px; padding: .8rem 1.2rem; font-weight: 700; font-size: 15px; border: 0; cursor: pointer; transition: transform .15s; }
    .a-btn:active { transform: scale(.97); }
    .b-m { background: #6b0f1a; color: #fbf7f2; } .b-g { background: #c9a24a; color: #1e1419; } .b-w { background: #25d366; color: #fff; }
    .b-o { background: #fff; color: #1e1419; border: 1px solid rgba(30,20,25,.18); } .b-r { background: #fff; color: #b42318; border: 1px solid #f1c3be; }
    .chip { display: inline-block; border-radius: 999px; padding: .2rem .65rem; font-size: 12px; font-weight: 800; text-transform: capitalize; }
    .st-new,.st-draft { background: #fdf2d6; color: #8a5a00; } .st-contacted,.st-sent { background: #e3eefc; color: #1d4f91; } .st-quoted,.st-accepted { background: #efe6fb; color: #5b2a9e; }
    .st-booked { background: #dcf5e4; color: #146c2e; } .st-lost,.st-cancelled { background: #f1eeee; color: #6f5f66; }
    .tab.on { color: #6b0f1a; } .tab.on .dot { background: #6b0f1a; }
    .sheet { position: fixed; inset: 0; z-index: 60; background: rgba(30,20,25,.45); display: flex; align-items: flex-end; justify-content: center; }
    .sheet > div { background: #fbf7f2; width: 100%; max-width: 640px; max-height: 92vh; overflow: auto; border-radius: 22px 22px 0 0; padding: 18px 16px calc(24px + env(safe-area-inset-bottom)); }
    @media (min-width: 700px) { .sheet { align-items: center; } .sheet > div { border-radius: 22px; } }
    .toast { position: fixed; left: 50%; bottom: 96px; transform: translateX(-50%); background: #1e1419; color: #fff; padding: .7rem 1.1rem; border-radius: 999px; font-weight: 700; z-index: 80; font-size: 14px; }
    .hide { display: none !important; }
  </style>
</head>
<body class="min-h-screen text-ink">
  <!-- LOGIN -->
  <section id="login" class="hide flex min-h-screen items-center justify-center px-4">
    <form id="login-form" class="a-card w-full max-w-sm p-6">
      <div class="mb-5 flex items-center gap-3">
        <span class="grid h-11 w-11 place-items-center rounded-xl bg-maroon font-display text-lg font-bold text-gold-300">RK</span>
        <div><p class="font-display text-2xl font-bold leading-none">{SITE.name}</p><p class="text-sm text-mute">Studio login</p></div>
      </div>
      <label class="a-lbl" for="pw">Password</label>
      <input id="pw" type="password" autocomplete="current-password" class="a-in" required />
      <p id="login-err" class="mt-2 hidden text-sm font-semibold text-[#b42318]"></p>
      <button class="a-btn b-m mt-4 w-full">Log in</button>
      <p class="mt-4 text-center text-xs text-mute">Tip: on your phone, tap Share → “Add to Home Screen” to use this like an app.</p>
    </form>
  </section>

  <!-- APP -->
  <section id="app" class="hide pb-28">
    <header class="sticky top-0 z-30 bg-maroon px-4 pb-3 pt-[calc(12px+env(safe-area-inset-top))] text-ivory">
      <div class="mx-auto flex max-w-3xl items-center justify-between">
        <div><p class="text-[11px] font-bold uppercase tracking-[.2em] text-gold-300">{SITE.name}</p><h1 id="title" class="font-display text-2xl font-bold leading-tight">Home</h1></div>
        <a href="/" target="_blank" class="rounded-full border border-white/30 px-3 py-1.5 text-xs font-bold">View website ↗</a>
      </div>
    </header>
    <main id="view" class="mx-auto max-w-3xl px-4 py-5"></main>
    <nav class="fixed inset-x-0 bottom-0 z-40 border-t border-ink/10 bg-white/95 pb-[env(safe-area-inset-bottom)] backdrop-blur">
      <div class="mx-auto grid max-w-3xl grid-cols-5 text-center text-[11.5px] font-bold text-mute">
        <button class="tab py-2.5" data-go="home"><div class="text-xl">🏠</div>Home<div class="dot mx-auto mt-1 h-1 w-1 rounded-full"></div></button>
        <button class="tab py-2.5" data-go="leads"><div class="text-xl">📥</div>Enquiries<div class="dot mx-auto mt-1 h-1 w-1 rounded-full"></div></button>
        <button class="tab py-2.5" data-go="quotes"><div class="text-xl">🧾</div>Quotes<div class="dot mx-auto mt-1 h-1 w-1 rounded-full"></div></button>
        <button class="tab py-2.5" data-go="messages"><div class="text-xl">💬</div>Messages<div class="dot mx-auto mt-1 h-1 w-1 rounded-full"></div></button>
        <button class="tab py-2.5" data-go="more"><div class="text-xl">⚙️</div>More<div class="dot mx-auto mt-1 h-1 w-1 rounded-full"></div></button>
      </div>
    </nav>
  </section>
  <div id="sheet-root"></div>

  <script is:inline define:vars={{ STUDIO: SITE.name }}>
  (function () {
    // ------------------------------------------------------------ utils
    var $ = function (s, r) { return (r || document).querySelector(s); };
    var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
    var esc = function (s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); };
    var inr = function (n) { return "₹" + Math.round(Number(n) || 0).toLocaleString("en-IN"); };
    var fmtDate = function (d) { if (!d) return ""; var x = new Date(d.length === 10 ? d + "T00:00:00" : d); return isNaN(x) ? d : x.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }); };
    var daysTo = function (d) { if (!d) return null; return Math.round((new Date(d + "T00:00:00") - new Date(new Date().toDateString())) / 864e5); };
    var waNum = function (p) { var d = String(p || "").replace(/\D/g, ""); if (d.length === 10) d = "91" + d; if (d.length === 11 && d[0] === "0") d = "91" + d.slice(1); return d; };
    var waLink = function (phone, text) { return "https://wa.me/" + waNum(phone) + "?text=" + encodeURIComponent(text); };
    function toast(msg) { var t = document.createElement("div"); t.className = "toast"; t.textContent = msg; document.body.appendChild(t); setTimeout(function () { t.remove(); }, 2200); }
    async function api(path, opts) {
      opts = opts || {};
      var res = await fetch("/api/admin/" + path, { method: opts.method || "GET", headers: opts.body ? { "content-type": "application/json" } : {}, body: opts.body ? JSON.stringify(opts.body) : undefined, credentials: "same-origin" });
      var data = await res.json().catch(function () { return { ok: false, error: "Network problem" }; });
      if (res.status === 401 && path !== "login") { showLogin(); throw new Error("login"); }
      if (!data.ok) { toast(data.error || "Something went wrong"); throw new Error(data.error); }
      return data;
    }
    var SETTINGS = null;
    async function settings(force) { if (!SETTINGS || force) SETTINGS = (await api("settings")).settings; return SETTINGS; }
    function fill(text, v) { return String(text).replace(/\{(\w+)\}/g, function (_, k) { return v[k] != null && v[k] !== "" ? v[k] : (k === "studio" ? STUDIO : ""); }); }
    function sheet(html, onMount) {
      var root = $("#sheet-root");
      root.innerHTML = '<div class="sheet"><div><div class="mb-3 flex justify-end"><button class="a-btn b-o !px-3 !py-1.5 text-sm" data-close>Close ✕</button></div>' + html + "</div></div>";
      var s = root.firstChild;
      s.addEventListener("click", function (e) { if (e.target === s || e.target.closest("[data-close]")) closeSheet(); });
      if (onMount) onMount(s);
      return s;
    }
    function closeSheet() { $("#sheet-root").innerHTML = ""; }

    // ------------------------------------------------------------ auth
    function showLogin() { $("#app").classList.add("hide"); $("#login").classList.remove("hide"); $("#pw").focus(); }
    $("#login-form").addEventListener("submit", async function (e) {
      e.preventDefault();
      var err = $("#login-err"); err.classList.add("hidden");
      var res = await fetch("/api/admin/login", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ password: $("#pw").value }) });
      var d = await res.json().catch(function () { return {}; });
      if (d.ok) { $("#pw").value = ""; start(); } else { err.textContent = d.error || "Could not log in"; err.classList.remove("hidden"); }
    });

    // ------------------------------------------------------------ router
    var TITLES = { home: "Home", leads: "Enquiries", quotes: "Quotes", messages: "Messages", more: "More", reviews: "Reviews", prices: "Prices", settings: "Settings", quote: "Quote" };
    function go(view, arg) {
      location.hash = view + (arg ? "/" + arg : "");
    }
    async function render() {
      var h = (location.hash || "#home").slice(1).split("/");
      var view = h[0] || "home", arg = h[1];
      $("#title").textContent = TITLES[view] || "Studio";
      $$(".tab").forEach(function (t) { t.classList.toggle("on", t.dataset.go === view || (view === "quote" && t.dataset.go === "quotes") || (["reviews", "prices", "settings"].indexOf(view) >= 0 && t.dataset.go === "more")); });
      var v = $("#view"); v.innerHTML = '<p class="py-10 text-center text-mute">Loading…</p>';
      try { await (VIEWS[view] || VIEWS.home)(v, arg); } catch (e) { if (e.message !== "login") v.innerHTML = '<p class="py-10 text-center text-mute">Could not load. Check your internet and try again.</p>'; }
      window.scrollTo(0, 0);
    }
    $$(".tab").forEach(function (t) { t.addEventListener("click", function () { go(t.dataset.go); }); });
    window.addEventListener("hashchange", render);

    var LEAD_ST = ["new", "contacted", "quoted", "booked", "lost"];
    var QUOTE_ST = ["draft", "sent", "accepted", "booked", "cancelled"];

    var VIEWS = {};
    // ------------------------------------------------------------ HOME
    VIEWS.home = async function (v) {
      var d = await api("dashboard");
      var hello = new Date().getHours() < 12 ? "Good morning" : new Date().getHours() < 17 ? "Good afternoon" : "Good evening";
      v.innerHTML =
        '<p class="font-display text-3xl font-bold">' + hello + ' 🌸</p><p class="text-mute">Here is your studio today.</p>' +
        '<div class="mt-5 grid grid-cols-2 gap-3">' +
          '<button class="a-card p-4 text-left" data-to="leads"><p class="text-4xl font-extrabold text-maroon">' + d.newLeads + '</p><p class="font-bold">New enquiries</p><p class="text-xs text-mute">Tap to reply</p></button>' +
          '<button class="a-card p-4 text-left" data-to="quotes"><p class="text-4xl font-extrabold text-maroon">' + d.openQuotes + '</p><p class="font-bold">Open quotes</p><p class="text-xs text-mute">Not booked yet</p></button>' +
        "</div>" +
        '<div class="mt-4 grid grid-cols-2 gap-3"><button class="a-btn b-m" id="nq">＋ New quote</button><button class="a-btn b-o" id="nl">＋ Add enquiry</button></div>' +
        '<h2 class="mt-7 font-display text-2xl font-bold">Upcoming bookings</h2>' +
        (d.bookings.length ? '<div class="mt-3 space-y-2">' + d.bookings.map(function (b) {
          var n = daysTo(b.weddingDate);
          return '<button class="a-card flex w-full items-center justify-between p-4 text-left" data-q="' + b.id + '"><div><p class="font-bold">' + esc(b.name) + '</p><p class="text-sm text-mute">' + fmtDate(b.weddingDate) + " · " + esc(b.number) + '</p></div><span class="chip st-booked">' + (n === 0 ? "Today" : n === 1 ? "Tomorrow" : "in " + n + " days") + "</span></button>";
        }).join("") + "</div>" : '<p class="mt-2 text-mute">No bookings yet. When a client confirms, open their quote and tap “Booked”.</p>');
      $$("[data-to]", v).forEach(function (b) { b.onclick = function () { go(b.dataset.to); }; });
      $$("[data-q]", v).forEach(function (b) { b.onclick = function () { go("quote", b.dataset.q); }; });
      $("#nq", v).onclick = function () { go("quote", "new"); };
      $("#nl", v).onclick = function () { leadForm(); };
    };

    // ------------------------------------------------------------ LEADS
    VIEWS.leads = async function (v) {
      var d = await api("leads"); var filter = "open";
      function draw() {
        var list = d.leads.filter(function (l) { return filter === "all" || (filter === "open" ? ["new", "contacted", "quoted"].indexOf(l.status) >= 0 : l.status === filter); });
        $("#list", v).innerHTML = list.length ? list.map(function (l) {
          return '<button class="a-card w-full p-4 text-left" data-id="' + l.id + '"><div class="flex items-start justify-between gap-3"><div><p class="text-lg font-bold">' + esc(l.name) + '</p><p class="text-sm text-mute">' + (l.date ? "💍 " + fmtDate(l.date) + " · " : "") + esc(l.city || "") + '</p>' + (l.events ? '<p class="mt-1 text-sm">' + esc(l.events) + "</p>" : "") + '</div><span class="chip st-' + l.status + '">' + l.status + '</span></div><p class="mt-2 text-xs text-mute">Received ' + fmtDate(l.createdAt) + "</p></button>";
        }).join("") : '<p class="py-8 text-center text-mute">Nothing here.</p>';
        $$("[data-id]", v).forEach(function (b) { b.onclick = function () { leadSheet(b.dataset.id); }; });
        $$("[data-f]", v).forEach(function (b) { b.className = "a-btn !px-3.5 !py-2 text-sm " + (b.dataset.f === filter ? "b-m" : "b-o"); });
      }
      v.innerHTML = '<div class="flex flex-wrap gap-2">' + ["open", "booked", "lost", "all"].map(function (f) { return '<button data-f="' + f + '" class="a-btn b-o !px-3.5 !py-2 text-sm">' + ({ open: "To do", booked: "Booked", lost: "Lost", all: "All" })[f] + "</button>"; }).join("") +
        '<button class="a-btn b-g ml-auto !px-3.5 !py-2 text-sm" id="add">＋ Add</button></div><div id="list" class="mt-4 space-y-3"></div>';
      $$("[data-f]", v).forEach(function (b) { b.onclick = function () { filter = b.dataset.f; draw(); }; });
      $("#add", v).onclick = function () { leadForm(); };
      draw();
    };
    function leadForm() {
      sheet('<h2 class="font-display text-2xl font-bold">Add an enquiry</h2><p class="text-sm text-mute">For enquiries that came by phone, Instagram or in person.</p>' +
        '<form id="lf" class="mt-4 space-y-3">' +
        '<div><label class="a-lbl">Name *</label><input name="name" class="a-in" required></div>' +
        '<div><label class="a-lbl">Phone / WhatsApp</label><input name="phone" class="a-in" inputmode="tel" placeholder="98xxxxxxxx"></div>' +
        '<div class="grid grid-cols-2 gap-3"><div><label class="a-lbl">Wedding date</label><input name="date" type="date" class="a-in"></div><div><label class="a-lbl">City</label><input name="city" class="a-in"></div></div>' +
        '<div><label class="a-lbl">Events</label><input name="events" class="a-in" placeholder="Roka, Mehndi, Anand Karaj…"></div>' +
        '<div><label class="a-lbl">Where did they find you?</label><select name="source" class="a-in"><option>phone</option><option>instagram</option><option>walk-in</option><option>referral</option><option>other</option></select></div>' +
        '<div><label class="a-lbl">Notes</label><textarea name="notes" rows="3" class="a-in"></textarea></div>' +
        '<button class="a-btn b-m w-full">Save enquiry</button></form>', function (s) {
        $("#lf", s).onsubmit = async function (e) { e.preventDefault(); var f = Object.fromEntries(new FormData(e.target)); await api("leads", { method: "POST", body: f }); closeSheet(); toast("Saved ✓"); go("leads"); render(); };
      });
    }
    async function leadSheet(id) {
      var l = (await api("leads/" + id)).lead; var s0 = await settings();
      var thanks = (s0.templates.find(function (t) { return t.id === "thanks"; }) || s0.templates[0] || { text: "Hi {name}" }).text;
      var s = sheet('<div class="flex items-start justify-between gap-3"><div><h2 class="font-display text-3xl font-bold">' + esc(l.name) + '</h2><p class="text-mute">' + esc(l.phone || "no phone") + "</p></div><span class=\"chip st-" + l.status + '">' + l.status + "</span></div>" +
        '<div class="a-card mt-4 space-y-1 p-4 text-[15px]">' +
          (l.date ? "<p>💍 <b>Wedding:</b> " + fmtDate(l.date) + "</p>" : "") + (l.city ? "<p>📍 <b>City:</b> " + esc(l.city) + "</p>" : "") +
          (l.who ? "<p>👤 <b>For:</b> " + esc(l.who) + "</p>" : "") + (l.events ? "<p>🎉 <b>Events:</b> " + esc(l.events) + "</p>" : "") +
          (l.message ? '<p class="pt-2 whitespace-pre-line">' + esc(l.message) + "</p>" : "") + '<p class="pt-2 text-xs text-mute">Received ' + fmtDate(l.createdAt) + " · " + esc(l.source || "") + "</p></div>" +
        (l.phone ? '<div class="mt-3 grid grid-cols-2 gap-2"><a class="a-btn b-w" target="_blank" href="' + waLink(l.phone, fill(thanks, { name: l.name.split(" ")[0], date: fmtDate(l.date) })) + '">WhatsApp reply</a><a class="a-btn b-o" href="tel:' + esc(l.phone) + '">📞 Call</a></div>' : "") +
        '<button id="mkq" class="a-btn b-m mt-2 w-full">🧾 Make a quote for ' + esc(l.name.split(" ")[0]) + "</button>" +
        '<p class="a-lbl mt-5">Status</p><div class="flex flex-wrap gap-2">' + LEAD_ST.map(function (st) { return '<button data-st="' + st + '" class="a-btn !px-3.5 !py-2 text-sm ' + (st === l.status ? "b-m" : "b-o") + '">' + st + "</button>"; }).join("") + "</div>" +
        '<label class="a-lbl mt-5">Your notes</label><textarea id="notes" rows="3" class="a-in">' + esc(l.notes || "") + '</textarea><button id="sn" class="a-btn b-o mt-2 w-full">Save notes</button>' +
        '<button id="del" class="a-btn b-r mt-6 w-full">Delete enquiry</button>', function (s) {
          $$("[data-st]", s).forEach(function (b) { b.onclick = async function () { await api("leads/" + id, { method: "PATCH", body: { status: b.dataset.st } }); toast("Marked " + b.dataset.st); closeSheet(); render(); }; });
          $("#sn", s).onclick = async function () { await api("leads/" + id, { method: "PATCH", body: { notes: $("#notes", s).value } }); toast("Notes saved ✓"); };
          $("#del", s).onclick = async function () { if (!confirm("Delete this enquiry? This cannot be undone.")) return; await api("leads/" + id, { method: "DELETE" }); closeSheet(); toast("Deleted"); render(); };
          $("#mkq", s).onclick = function () { sessionStorage.setItem("rk_prefill", JSON.stringify({ leadId: id, client: { name: l.name, phone: l.phone }, weddingDate: l.date, city: l.city, events: l.events })); closeSheet(); go("quote", "new"); };
        });
    }

    // ------------------------------------------------------------ QUOTES
    VIEWS.quotes = async function (v) {
      var d = await api("quotes");
      v.innerHTML = '<button class="a-btn b-m w-full" id="nq">＋ New quote</button><div class="mt-4 space-y-3">' + (d.quotes.length ? d.quotes.map(function (q) {
        return '<button class="a-card w-full p-4 text-left" data-id="' + q.id + '"><div class="flex items-start justify-between gap-3"><div><p class="text-lg font-bold">' + esc(q.name || "(no name)") + '</p><p class="text-sm text-mute">' + esc(q.number) + " · v" + q.version + (q.weddingDate ? " · 💍 " + fmtDate(q.weddingDate) : "") + '</p></div><div class="text-right"><p class="font-extrabold text-maroon">' + inr(q.total) + '</p><span class="chip st-' + q.status + '">' + q.status + "</span></div></div></button>";
      }).join("") : '<p class="py-8 text-center text-mute">No quotes yet.</p>') + "</div>";
      $("#nq", v).onclick = function () { go("quote", "new"); };
      $$("[data-id]", v).forEach(function (b) { b.onclick = function () { go("quote", b.dataset.id); }; });
    };
    VIEWS.quote = async function (v, id) {
      var s0 = await settings();
      var q;
      if (id === "new") { q = Object.assign({ client: { name: "", phone: "" }, items: [], discount: 0, advance: 0, notes: "", status: "draft" }, JSON.parse(sessionStorage.getItem("rk_prefill") || "{}")); sessionStorage.removeItem("rk_prefill"); }
      else q = (await api("quotes/" + id)).quote;
      var isNew = id === "new";
      function totals() { var sub = q.items.reduce(function (a, i) { return a + (Number(i.qty) || 0) * (Number(i.price) || 0); }, 0); var tot = Math.max(0, sub - (Number(q.discount) || 0)); return { sub: sub, tot: tot, bal: Math.max(0, tot - (Number(q.advance) || 0)) }; }
      function itemsHtml() {
        return q.items.map(function (it, i) {
          return '<div class="a-card p-3" data-i="' + i + '"><div class="flex gap-2"><input class="a-in flex-1 !py-2" data-k="label" value="' + esc(it.label) + '" placeholder="Item"><button class="a-btn b-r !px-3 !py-2" data-rm>✕</button></div>' +
            '<div class="mt-2 grid grid-cols-3 gap-2"><div><span class="a-lbl">Qty</span><input class="a-in !py-2" data-k="qty" type="number" inputmode="numeric" min="1" value="' + (it.qty || 1) + '"></div><div><span class="a-lbl">Price ₹</span><input class="a-in !py-2" data-k="price" type="number" inputmode="numeric" min="0" value="' + (it.price || 0) + '"></div><div><span class="a-lbl">Amount</span><p class="py-2 font-extrabold" data-amt>' + inr(it.qty * it.price) + "</p></div></div>" +
