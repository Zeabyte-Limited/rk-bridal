---
import Layout from "../layouts/Layout.astro";
import VideoHero from "../components/VideoHero.astro";
import SectionHead from "../components/SectionHead.astro";
import Faq from "../components/Faq.astro";
import Gallery from "../components/Gallery.astro";
import BookingForm from "../components/BookingForm.astro";
import CtaBand from "../components/CtaBand.astro";
import { SITE, WHATSAPP_URL } from "../config";
import { gallery } from "../data/gallery";
import { faqSchema, serviceSchema, breadcrumbSchema } from "../lib/schema";

const title = `Hindu Punjabi Wedding Makeup Artist in Jalandhar — Pheras, Choora & Sehra | ${SITE.name}`;
const description = "Makeup and hair for Hindu Punjabi weddings in Punjab: roka, chunni, mehndi, maiyan, jaggo, choora, sehra bandi, ghodi, pheras and reception. Bridal HD and airbrush looks plus groom grooming. Based in Jalandhar.";

const day = [
  { t: "Roka & chunni", d: "A soft, traditional first look for the roka and the chunni ceremony — fresh skin, defined eyes, the chunni framing your face." },
  { t: "Mehndi & sangeet", d: "Dewy, colourful makeup and a floral or paranda braid, sweat-proof for an evening of dancing with the whole family." },
  { t: "Maiyan / vatna", d: "Minimal makeup and tied-back hair for the vatna, with skin prep so it comes off clean and leaves you glowing." },
  { t: "Choora & kaleere", d: "Base set before the choora ceremony; kaleere tied to the choora and set so they fall beautifully in every photo." },
  { t: "Pheras", d: "A rich, classic bridal look built for an evening or night mandap — warm light, the sacred fire, and a long ceremony that the makeup has to last through." },
  { t: "Vidaai & reception", d: "A refresh before the doli, then a brand-new, flash-tested look for the reception." },
];
const groom = [
  { t: "Sehra bandi ready", d: "Matte, rested skin and hair styled to sit under the safa and sehra — no flat hair when the sehra comes off at the reception." },
  { t: "Ghodi & baraat", d: "Long-wear grooming that survives the ghodi, the dancing baraat and the milni without shine." },
  { t: "Mandap finish", d: "Warm mandap light and the fire show everything — we even out skin tone so the pheras photos look natural." },
];
const faqs = [
  { q: "How is a Hindu Punjabi wedding different for makeup?", a: "The pheras are often in the evening or late at night, so the bridal look is designed for warm mandap light and a long ceremony. The choora, kaleere and chunni are the same Punjabi traditions, and the vatna (maiyan) needs careful skin prep." },
  { q: "Can you do the makeup for both the choora ceremony and the pheras?", a: "Yes. We usually set the base early for the choora ceremony, then finish hair, eyes and draping closer to the baraat. For a late-night phera, an artist can stay for a refresh." },
  { q: "Do you do the groom's makeup for the sehra bandi?", a: "Yes — natural grooming at home before the sehra bandi, styled to sit under the safa and sehra, and to look good when it comes off later." },
  { q: "Do you do the family too?", a: "Yes — mummy ji, bhua, maasi, bhabhis and sisters at home or at the venue, with group rates." },
  { q: "Do you also do Sikh weddings?", a: "Yes — Sikh and Hindu Punjabi weddings are our whole focus. Many Punjabi families have both traditions in one wedding, and we're comfortable with both." },
];
const looks = gallery.filter((g) => /hindu|punjabi|ghodi|safa|chooda|bride-red|mehndi|hair-bun/.test(g.image)).slice(0, 12);
const schema = [
  serviceSchema({ name: "Hindu Punjabi Wedding Makeup", description, path: "/hindu-punjabi-wedding-makeup/" }),
  faqSchema(faqs),
  breadcrumbSchema([{ name: "Home", path: "/" }, { name: "Hindu Punjabi Wedding Makeup", path: "/hindu-punjabi-wedding-makeup/" }]),
];
---

<Layout title={title} description={description} path="/hindu-punjabi-wedding-makeup/" transparentHeader schema={schema} image="/images/couple-punjabi-steps-red.webp">
  <VideoHero video="hero-hindu" poster="v-hero-hindu" eyebrow="For Hindu Punjabi families" min="min-h-[80svh]">
    <h1 class="max-w-4xl text-5xl leading-[1.02] sm:text-6xl md:text-7xl">Hindu Punjabi wedding makeup — <span class="text-gold-300">choora</span> to pheras</h1>
    <p class="mt-5 max-w-2xl text-[17px] leading-8 text-ivory/90 sm:text-lg">Bridal makeup and hair for the choora, the pheras and every function in between, plus groom grooming for the sehra bandi and the baraat. Based in Jalandhar, all over Punjab.</p>
    <div slot="actions" class="mt-8 flex flex-wrap gap-3">
      <a href={WHATSAPP_URL("Hi! I'd like to check your availability for our wedding.")} target="_blank" rel="noopener" class="btn btn-whatsapp !px-7 !py-3.5 !text-[15px]">Check your date</a>
      <a href="#looks" class="btn btn-ghost-light !px-7 !py-3.5 !text-[15px]">See the looks</a>
    </div>
  </VideoHero>

  <section class="wash py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <SectionHead eyebrow="Every ceremony" title="From the roka to the vidaai." sub="Punjabi weddings are a week of functions. One team, one trial, a look for each — and the same faces with you every day." />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {day.map((d, i) => (
          <div class="card card-hover fade-up p-7"><p class="font-display text-3xl font-bold text-gold">{String(i + 1).padStart(2, "0")}</p><h3 class="mt-1 text-2xl">{d.t}</h3><p class="mt-2 text-[15px] leading-7 text-ink-soft">{d.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-24">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHead eyebrow="For the groom" title="Sehra bandi to the reception stage." />
        <div class="mt-8 space-y-5">
          {groom.map((g) => (<div class="border-l-2 border-gold pl-5"><h3 class="text-2xl">{g.t}</h3><p class="mt-1 text-[15px] leading-7 text-ink-soft">{g.d}</p></div>))}
        </div>
        <a href="/groom-makeup/" class="btn btn-maroon mt-8">Groom grooming</a>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="img-frame aspect-[3/4]"><img src="/images/groom-ghodi.webp" alt="Groom on the ghodi at the baraat" loading="lazy" class="h-full w-full object-cover" /></div>
        <div class="img-frame mt-10 aspect-[3/4]"><img src="/images/groom-pink-safa.webp" alt="Groom in a pink safa" loading="lazy" class="h-full w-full object-cover" /></div>
      </div>
    </div>
  </section>

  <section id="looks" class="bg-blush/50 py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <SectionHead center eyebrow="Punjabi brides & grooms" title="Choora, chunni & pheras looks" />
      <div class="mt-12"><Gallery items={looks} columns="columns-2 md:columns-3 lg:columns-4" /></div>
      <div class="mt-8 text-center"><a href="/portfolio/" class="btn btn-ghost">Full portfolio</a></div>
    </div>
  </section>

  <section class="py-20 sm:py-24">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-12">
      <div class="lg:col-span-4"><SectionHead eyebrow="FAQ" title="Questions Punjabi brides ask" /></div>
      <div class="lg:col-span-8"><Faq items={faqs} /></div>
    </div>
  </section>

  <section class="wash py-20 sm:py-24"><div class="mx-auto max-w-3xl px-4 sm:px-6"><BookingForm title="Check your wedding date" /></div></section>
  <CtaBand image="couple-punjabi-steps-red" />
</Layout>
