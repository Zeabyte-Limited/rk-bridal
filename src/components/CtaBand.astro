---
import { WHATSAPP_URL } from "../config";
interface Props { title?: string; sub?: string; image?: string }
const { title = "Your date, our calendar — let’s lock it in.", sub = "Tell us the date and the events. We reply on WhatsApp within a few hours with availability and a clear quote.", image = "couple-sikh-red-hall" } = Astro.props;
---
<section class="relative isolate my-24 overflow-hidden">
  <img src={`/images/${image}.webp`} alt="" loading="lazy" class="absolute inset-0 -z-20 h-full w-full object-cover object-center" />
  <div class="absolute inset-0 -z-10 bg-maroon-900/80"></div>
  <div class="mx-auto max-w-5xl px-4 py-20 text-center text-ivory sm:px-6 sm:py-28">
    <p class="script text-3xl text-gold-300 sm:text-4xl">Book your date</p>
    <h2 class="mt-2 text-4xl sm:text-5xl md:text-6xl">{title}</h2>
    <p class="mx-auto mt-5 max-w-2xl text-[17px] leading-8 text-ivory/85">{sub}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={WHATSAPP_URL("Hi! I'd like to check if you're available for my wedding date.")} target="_blank" rel="noopener" class="btn btn-whatsapp !px-7 !py-3.5 !text-[15px]">Check availability on WhatsApp</a>
      <a href="/contact/" class="btn btn-gold !px-7 !py-3.5 !text-[15px]">Send booking details</a>
    </div>
  </div>
</section>
