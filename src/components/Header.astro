---
import { SITE, WHATSAPP_URL } from "../config";
interface Props { transparent?: boolean }
const { transparent = false } = Astro.props;

const links = [
  { href: "/bridal-makeup/", label: "Bridal" },
  { href: "/groom-makeup/", label: "Groom" },
  { href: "/services/", label: "Services" },
  { href: "/packages/", label: "Packages" },
  { href: "/portfolio/", label: "Portfolio" },
  { href: "/areas/", label: "Areas" },
  { href: "/blog/", label: "Blog" },
  { href: "/about/", label: "About" },
];
const current = Astro.url.pathname;
---

<header id="site-header" class:list={["fixed inset-x-0 top-0 z-50 transition-[background,color,box-shadow] duration-300", transparent ? "is-transparent text-white" : "glass text-ink"]}>
  <nav class="mx-auto flex h-[4.5rem] max-w-7xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label={`${SITE.name} home`}>
      <span class="grid h-10 w-10 place-items-center rounded-xl bg-maroon font-display text-base font-bold text-gold-300 shadow-md">RK</span>
      <span class="flex flex-col leading-none">
        <span class="font-display text-[1.35rem] font-semibold tracking-tight">{SITE.name}</span>
        <span class="mt-0.5 text-[9.5px] font-bold uppercase tracking-[0.22em] opacity-80">Jalandhar · Punjab</span>
      </span>
    </a>

    <div class="hidden items-center gap-6 lg:flex">
      {links.map((l) => (
        <a href={l.href} class:list={["text-[13.5px] font-semibold tracking-wide transition hover:text-gold", current.startsWith(l.href) && "underline decoration-gold decoration-2 underline-offset-8"]}>{l.label}</a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <a href={WHATSAPP_URL()} target="_blank" rel="noopener" class="btn btn-whatsapp hidden !px-4 !py-2.5 md:inline-flex" aria-label="Chat on WhatsApp">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 3.5A11.9 11.9 0 0 0 12 0C5.4 0 .1 5.3.1 11.9c0 2.1.5 4.1 1.6 5.9L0 24l6.3-1.7a11.9 11.9 0 0 0 5.7 1.5c6.6 0 11.9-5.3 11.9-11.9 0-3.2-1.2-6.2-3.4-8.4ZM12 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 0 1 2.1 12C2.1 6.5 6.5 2.1 12 2.1c2.6 0 5.1 1 7 2.9a9.8 9.8 0 0 1 2.9 7c0 5.4-4.4 9.8-9.9 9.8Zm5.4-7.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4Z"/></svg>
        WhatsApp
      </a>
      <a href="/contact/" class="btn btn-book hidden !px-5 !py-2.5 sm:inline-flex">Book your date</a>
      <button id="menu-btn" aria-label="Open menu" aria-expanded="false" class="grid h-10 w-10 place-items-center rounded-full lg:hidden">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="20" y2="17" /></svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="glass hidden border-t border-ink/8 px-5 pb-5 pt-2 text-ink lg:hidden">
    {links.map((l) => (
      <a href={l.href} class="block border-b border-ink/8 py-3 text-base font-semibold">{l.label}</a>
    ))}
    <a href="/testimonials/" class="block border-b border-ink/8 py-3 text-base font-semibold">Reviews</a>
    <a href="/contact/" class="block border-b border-ink/8 py-3 text-base font-semibold">Contact</a>
    <div class="mt-4 grid grid-cols-2 gap-2">
      <a href="/contact/" class="btn btn-maroon">Book your date</a>
      <a href={WHATSAPP_URL()} target="_blank" rel="noopener" class="btn btn-whatsapp">WhatsApp</a>
    </div>
    <a href={`tel:${SITE.phoneE164}`} class="mt-3 block text-center text-sm font-semibold text-maroon">Call {SITE.phoneDisplay}</a>
  </div>
</header>

<style>
  #site-header .btn-book { background: var(--color-maroon); color: var(--color-ivory); }
  #site-header.is-transparent:not(.scrolled) { background: linear-gradient(180deg, rgba(30,20,25,.55), rgba(30,20,25,0)); }
  #site-header.is-transparent:not(.scrolled) .btn-book { background: var(--color-gold); color: var(--color-ink); }
  #site-header.is-transparent.scrolled { background: rgba(251,247,242,.9); color: var(--color-ink); backdrop-filter: saturate(160%) blur(14px); -webkit-backdrop-filter: saturate(160%) blur(14px); box-shadow: 0 1px 0 rgba(30,20,25,.08); }
  #site-header.menu-open { background: rgba(251,247,242,.96); color: var(--color-ink); }
  #site-header.menu-open .btn-book { background: var(--color-maroon); color: var(--color-ivory); }
</style>

<script is:inline>
  (function () {
    var h = document.getElementById("site-header");
    var btn = document.getElementById("menu-btn");
    var menu = document.getElementById("mobile-menu");
    function onScroll() { h.classList.toggle("scrolled", window.scrollY > 24); }
    onScroll(); window.addEventListener("scroll", onScroll, { passive: true });
    btn.addEventListener("click", function () {
      var open = menu.classList.toggle("hidden") === false;
      h.classList.toggle("menu-open", open);
      btn.setAttribute("aria-expanded", String(open));
    });
  })();
</script>
