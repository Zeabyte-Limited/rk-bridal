        '<label class="a-lbl">Your studio WhatsApp number</label><input id="wa" class="a-in" inputmode="tel" value="' + esc(s0.studioWhatsapp) + '"><p class="mt-1 text-xs text-mute">With country code, e.g. 919876543210. Clients tap “Accept” on a quote and it comes to this number.</p>' +
        '<label class="a-lbl mt-5">Terms shown under every quote</label><textarea id="terms" rows="4" class="a-in">' + esc(s0.quoteTerms) + "</textarea>" +
        '<h2 class="mt-6 font-display text-2xl font-bold">Ready-made messages</h2><p class="text-sm text-mute">These words fill in by themselves: {name} {date} {link} {total} {advance} {studio}</p>' +
        '<div id="tlist" class="mt-3 space-y-2"></div><button id="tadd" class="a-btn b-o mt-3 w-full">＋ Add a message</button>' +
        '<button id="ssave" class="a-btn b-m mt-4 w-full !py-4 text-base">Save settings</button>' +
        '<h2 class="mt-8 font-display text-2xl font-bold">Change password</h2><div class="mt-3 space-y-2"><input id="cur" type="password" class="a-in" placeholder="Current password" autocomplete="current-password"><input id="nw" type="password" class="a-in" placeholder="New password (8+ characters)" autocomplete="new-password"><button id="cpw" class="a-btn b-o w-full">Change password</button></div>';
      drawT();
      $("#tadd", v).onclick = function () { s0.templates.push({ id: "t" + Date.now(), title: "New message", text: "Hi {name} ji, " }); drawT(); };
      $("#ssave", v).onclick = async function () { s0.studioWhatsapp = $("#wa", v).value; s0.quoteTerms = $("#terms", v).value; SETTINGS = (await api("settings", { method: "PUT", body: s0 })).settings; toast("Settings saved ✓"); };
      $("#cpw", v).onclick = async function () { await api("password", { method: "POST", body: { current: $("#cur", v).value, next: $("#nw", v).value } }); $("#cur", v).value = $("#nw", v).value = ""; toast("Password changed ✓"); };
    };

    // ------------------------------------------------------------ boot
    async function start() {
      try { await api("me"); } catch (e) { return; }
      $("#login").classList.add("hide"); $("#app").classList.remove("hide");
      render();
    }
    start();
  })();
  </script>
</body>
</html>
