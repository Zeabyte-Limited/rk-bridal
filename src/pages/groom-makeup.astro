---
import Layout from "../layouts/Layout.astro";
import VideoHero from "../components/VideoHero.astro";
import SectionHead from "../components/SectionHead.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import BookingForm from "../components/BookingForm.astro";
import { SITE, WHATSAPP_URL } from "../config";
import { faqSchema, serviceSchema, breadcrumbSchema } from "../lib/schema";

const title = `Groom Makeup & Grooming in Jalandhar — Natural, Camera-Ready | ${SITE.name}`;
const description = "Groom makeup in Jalandhar, Punjab: invisible HD grooming, beard shaping, hair styling (dastaar and sehra friendly), pre-wedding and reception looks for grooms. Travelling across Punjab.";

const what = [
  { t: "Skin that looks rested", d: "Light HD base matched to your neck, dark circles and razor marks evened out, oil controlled for a full day under lights. Nobody can tell — they just think you look great." },
  { t: "Beard & hair", d: "Beard lined and conditioned, hair styled to last — dastaar-ready for Sikh grooms, sehra-safe for everyone else, and photographed from every angle." },
  { t: "The sherwani check", d: "Collar, kalgi, safa, brooch and dupatta set straight before you walk out. We check the back too — the photographer will." },
  { t: "Pre-wedding shoot", d: "Natural, outdoor-proof grooming for the shoot — matte skin, tidy brows, hair that holds in the wind." },
  { t: "Reception", d: "A sharper evening look: sculpted matte skin, defined beard, hair reset — ready for the stage and the flash." },
  { t: "Groomsmen & family", d: "Brothers, cousins and dads — quick, natural grooming so the whole baraat looks sharp in the group photos." },
];

const steps = [
  ["Week 4", "Book. Start a simple skincare routine: cleanser, moisturiser, sunscreen. Fix the beard shape with your barber."],
  ["Week 1", "Final haircut (not the day before). Hydrate. Avoid new skincare products — no surprises."],
  ["The day", "We arrive 90 minutes before you need to be ready. Skin, beard, hair, sherwani check. Touch-up kit left with your brother."],
];

const faqs = [
  { q: "Will people be able to tell I’m wearing makeup?", a: "No. Groom grooming is matte, sheer and colour-matched. The goal is ‘rested and sharp’, not ‘made up’. Photographers love it because there is nothing to retouch." },
  { q: "Do you do grooming for Sikh grooms with a dastaar?", a: "Yes. We work around the dastaar — skin, beard, brows and the hairline — and set the kalgi and safa so the whole look is clean in photos." },
  { q: "How long does groom makeup take?", a: "30–45 minutes, done where you are getting ready. Pre-wedding and reception looks take about the same." },
  { q: "Can you do the bride and the groom at the same time?", a: "Yes — a second artist handles the groom while the bride is being done, so both are ready together and the finish matches." },
  { q: "Do you travel for groom bookings?", a: "Yes, anywhere in Punjab and for destination weddings. If the bride is booked with us, the groom is usually an easy add-on." },
];

const schema = [
  serviceSchema({ name: "Groom Makeup & Grooming", description, path: "/groom-makeup/" }),
  faqSchema(faqs),
  breadcrumbSchema([{ name: "Home", path: "/" }, { name: "Groom Makeup", path: "/groom-makeup/" }]),
];
---

<Layout title={title} description={description} path="/groom-makeup/" transparentHeader schema={schema} image="/images/v-hero-groom.webp">
  <VideoHero video="hero-groom" poster="v-hero-groom" eyebrow="For the groom" min="min-h-[80svh]">
    <h1 class="max-w-4xl text-5xl leading-[1.02] sm:text-6xl md:text-7xl">Groom Makeup &amp; Grooming in Jalandhar — <span class="text-gold-300">invisible</span>, camera-ready</h1>
    <p class="mt-5 max-w-2xl text-[17px] leading-8 text-ivory/90 sm:text-lg">Rested skin, a sharp beard, hair that holds under a sehra or dastaar. Natural grooming for the wedding, the pre-wedding shoot and the reception.</p>
    <div slot="actions" class="mt-8 flex flex-wrap gap-3">
      <a href={WHATSAPP_URL("Hi! I'd like to enquire about groom makeup and grooming.")} target="_blank" rel="noopener" class="btn btn-whatsapp !px-7 !py-3.5 !text-[15px]">Enquire on WhatsApp</a>
      <a href="/portfolio/" class="btn btn-ghost-light !px-7 !py-3.5 !text-[15px]">See groom looks</a>
    </div>
  </VideoHero>

  <section class="wash py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <SectionHead eyebrow="What we do for grooms" title="You, on your best day — not a different person." sub="Most grooms have never worn makeup and never will again. That is exactly how it should look." />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {what.map((w) => (<div class="card card-hover fade-up p-7"><h3 class="text-2xl">{w.t}</h3><p class="mt-2 text-[15px] leading-7 text-ink-soft">{w.d}</p></div>))}
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHead eyebrow="Groom timeline" title="Three small steps to a great wedding-day face." />
        <ol class="mt-8 space-y-5">
          {steps.map(([w, d]) => (<li class="flex gap-5"><span class="font-display text-3xl font-bold text-gold">{w}</span><p class="pt-1 text-[15.5px] leading-7 text-ink-soft">{d}</p></li>))}
        </ol>
        <a href="/blog/groom-grooming-checklist-4-weeks/" class="btn btn-ghost mt-8">Read the full groom checklist</a>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="img-frame aspect-[3/4]"><img src="/images/groom-sehra.webp" alt="Groom in sehra and cream sherwani" loading="lazy" class="h-full w-full object-cover" /></div>
        <div class="img-frame mt-10 aspect-[3/4]"><img src="/images/groom-pink-turban.webp" alt="Groom in pink turban, natural grooming" loading="lazy" class="h-full w-full object-cover" /></div>
      </div>
    </div>
  </section>

  <section class="wash py-20 sm:py-24">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-12">
      <div class="lg:col-span-4"><SectionHead eyebrow="Groom FAQ" title="What grooms ask" /></div>
      <div class="lg:col-span-8"><Faq items={faqs} /></div>
    </div>
  </section>

  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6"><BookingForm title="Book groom grooming" /></div>
  </section>

  <CtaBand image="couple-sikh-portrait" title="Bride and groom, one team, one finish." />
</Layout>
