---
import Layout from "../../layouts/Layout.astro";
import VideoHero from "../../components/VideoHero.astro";
import SectionHead from "../../components/SectionHead.astro";
import CtaBand from "../../components/CtaBand.astro";
import { SITE, WHATSAPP_URL } from "../../config";
import { areas } from "../../data/areas";
import { breadcrumbSchema } from "../../lib/schema";

const title = `Bridal Makeup Artist Across Punjab — Jalandhar, Chandigarh, Ludhiana, Amritsar | ${SITE.name}`;
const description = "We travel for weddings across Punjab: Jalandhar (home), Phagwara, Kapurthala, Hoshiarpur, Nawanshahr, Ludhiana, Amritsar, Moga, Pathankot, Chandigarh, Mohali and Patiala — plus destination weddings.";
---

<Layout title={title} description={description} path="/areas/" transparentHeader schema={breadcrumbSchema([{ name: "Home", path: "/" }, { name: "Areas", path: "/areas/" }])} image="/images/v-hero-areas.webp">
  <VideoHero video="hero-areas" poster="v-hero-areas" eyebrow="Where we work" min="min-h-[70svh]">
    <h1 class="max-w-4xl text-5xl leading-[1.02] sm:text-6xl md:text-7xl">Jalandhar is home. <span class="text-gold-300">All of Punjab</span> is our calendar.</h1>
    <p class="mt-5 max-w-2xl text-[17px] leading-8 text-ivory/90 sm:text-lg">No travel charge inside Jalandhar. Simple travel zones for the rest of Punjab, and the full team comes along — makeup, hair, draping.</p>
    <div slot="actions" class="mt-8 flex flex-wrap gap-3">
      <a href={WHATSAPP_URL("Hi! Do you travel to my city for wedding makeup?")} target="_blank" rel="noopener" class="btn btn-whatsapp !px-7 !py-3.5 !text-[15px]">Ask about your city</a>
    </div>
  </VideoHero>

  <section class="wash py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <SectionHead eyebrow="Cities & towns" title="Pick your city" />
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {areas.map((a) => (
          <a href={`/areas/${a.slug}/`} class="card card-hover fade-up flex items-start justify-between gap-4 p-6">
            <div>
              <h2 class="text-2xl">Makeup artist in {a.name}</h2>
              <p class="mt-1 text-sm text-mute">{a.distanceKm === 0 ? "Home base" : `${a.distanceKm} km · ${a.travel}`}</p>
            </div>
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-blush text-maroon">→</span>
          </a>
        ))}
      </div>
      <p class="mt-8 text-[15px] text-ink-soft">Not listed? We cover every town in Punjab and destination weddings across India and abroad — just ask.</p>
    </div>
  </section>

  <CtaBand image="anand-karaj-palki" />
</Layout>
